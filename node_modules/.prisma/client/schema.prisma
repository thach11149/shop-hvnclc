  shop       Shop?            @relation(fields: [shopId], references: [id])
  productId  String?
  campaignId String?
  code       String           @unique
  url        String
  clickCount Int              @default(0)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())

