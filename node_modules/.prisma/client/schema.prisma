generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  phone         String?    @unique
  passwordHash  String
  role          UserRole   @default(BUYER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  phoneVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  buyerProfile           BuyerProfile?
  sellerProfile          SellerProfile?
  adminProfile           AdminProfile?
  addresses              UserAddress[]
  cart                   Cart?
  orders                 Order[]
  reviews                Review[]
  refreshTokens          RefreshToken[]
  notifications          Notification[]
  loyaltyAccount         LoyaltyAccount?
  searchHistories        SearchHistory[]
  behaviorEvents         BehaviorEvent[]
  chatThreadsAsBuyer     ChatThread[]            @relation("BuyerThreads")
  chatThreadsAsSeller    ChatThread[]            @relation("SellerThreads")
  affiliatePartner       AffiliatePartner?
  referralCode           ReferralCode?
  referralInvites        ReferralInvite[]        @relation("InviterInvites")
  referralReceived       ReferralInvite?         @relation("InviteeInvite")
  marketingMessages      MarketingMessageLog[]
  customerSegmentMembers CustomerSegmentMember[]

  @@map("users")
}

enum UserRole {
  BUYER
  SELLER_OWNER
  SELLER_STAFF
  ADMIN_OPERATOR
  ADMIN_FINANCE
  ADMIN_CONTENT
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@map("refresh_tokens")
}

model BuyerProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  fullName  String?
  avatar    String?
  birthDate DateTime?
  gender    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("buyer_profiles")
}

model SellerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  fullName  String
  idNumber  String?
  idFront   String?
  idBack    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop?

  @@map("seller_profiles")
}

model AdminProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  fullName   String
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("admin_profiles")
}

model UserAddress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  fullName    String
  phone       String
  addressLine String
  ward        String?
  district    String
  province    String
  country     String   @default("VN")
  zipCode     String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_addresses")
}

// ============================================================
// SELLER & SHOP
// ============================================================

model Shop {
  id              String        @id @default(uuid())
  sellerProfileId String        @unique
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id])
  name            String
  slug            String        @unique
  description     String?
  logo            String?
  banner          String?
  status          ShopStatus    @default(PENDING_APPROVAL)
  rejectionReason String?
  commissionRate  Decimal       @default(10) @db.Decimal(5, 2)
  phone           String?
  email           String?
  addressLine     String?
  district        String?
  province        String?
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  staffs           ShopStaff[]
  products         Product[]
  orders           Order[]
  vouchers         Promotion[]               @relation("ShopPromotions")
  wallet           SellerWallet?
  bankAccounts     SellerBankAccount[]
  campaigns        CampaignSeller[]
  followers        ShopFollower[]
  collections      ShopCollection[]
  shopBanners      ShopBanner[]
  returnRequests   ReturnRequest[]
  inboundRequests  WarehouseInboundRequest[]
  adsCampaigns     AdsCampaign[]
  affiliateLinks   AffiliateLink[]
  disputes         Dispute[]
  staffPermissions ShopStaffPermission[]

  @@map("shops")
}

enum ShopStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  CLOSED
}

model ShopStaff {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@map("shop_staffs")
}

model ShopStaffPermission {
  id         String   @id @default(uuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id])
  userId     String
  permission String
  createdAt  DateTime @default(now())

  @@map("shop_staff_permissions")
}

model SellerBankAccount {
  id            String   @id @default(uuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id])
  bankName      String
  accountNumber String
  accountName   String
  branch        String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("seller_bank_accounts")
}

model ShopBanner {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  imageUrl  String
  link      String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("shop_banners")
}

model ShopCollection {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products ShopCollectionProduct[]

  @@map("shop_collections")
}

model ShopCollectionProduct {
  id           String         @id @default(uuid())
  collectionId String
  collection   ShopCollection @relation(fields: [collectionId], references: [id])
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  position     Int            @default(0)
  createdAt    DateTime       @default(now())

  @@map("shop_collection_products")
}

model ShopFollower {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([shopId, userId])
  @@map("shop_followers")
}

// ============================================================
// CATALOG
// ============================================================

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  position    Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id              String        @id @default(uuid())
  shopId          String
  shop            Shop          @relation(fields: [shopId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  name            String
  slug            String        @unique
  description     String?
  brand           String?
  status          ProductStatus @default(DRAFT)
  rejectionReason String?
  weight          Decimal?      @db.Decimal(10, 3)
  width           Decimal?      @db.Decimal(10, 2)
  height          Decimal?      @db.Decimal(10, 2)
  length          Decimal?      @db.Decimal(10, 2)
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  images             ProductImage[]
  attributes         ProductAttribute[]
  skus               SKU[]
  reviews            Review[]
  variantGroups      ProductVariantGroup[]
  campaignProducts   CampaignProduct[]
  flashSaleItems     FlashSaleItem[]
  collectionProducts ShopCollectionProduct[]
  wishlistItems      WishlistItem[]
  behaviorEvents     BehaviorEvent[]

  @@map("products")
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  value     String
  createdAt DateTime @default(now())

  @@map("product_attributes")
}

model ProductVariantGroup {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  options ProductVariantOption[]

  @@map("product_variant_groups")
}

model ProductVariantOption {
  id       String              @id @default(uuid())
  groupId  String
  group    ProductVariantGroup @relation(fields: [groupId], references: [id])
  value    String
  position Int                 @default(0)

  skuVariantValues ProductSKUVariantValue[]

  @@map("product_variant_options")
}

model ProductSKUVariantValue {
  id       String               @id @default(uuid())
  skuId    String
  sku      SKU                  @relation(fields: [skuId], references: [id])
  optionId String
  option   ProductVariantOption @relation(fields: [optionId], references: [id])

  @@unique([skuId, optionId])
  @@map("product_sku_variant_values")
}

model SKU {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  skuCode      String   @unique
  name         String
  price        Decimal  @db.Decimal(15, 2)
  comparePrice Decimal? @db.Decimal(15, 2)
  costPrice    Decimal? @db.Decimal(15, 2)
  image        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variantValues  ProductSKUVariantValue[]
  inventoryStock InventoryStock?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  flashSaleItems FlashSaleItem[]
  comboItems     ComboDealItem[]

  @@map("skus")
}

// ============================================================
// INVENTORY
// ============================================================

model InventoryStock {
  id                String   @id @default(uuid())
  skuId             String   @unique
  sku               SKU      @relation(fields: [skuId], references: [id])
  totalQuantity     Int      @default(0)
  reservedQuantity  Int      @default(0)
  soldQuantity      Int      @default(0)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reservations InventoryReservation[]

  @@map("inventory_stocks")
}

model InventoryReservation {
  id         String            @id @default(uuid())
  stockId    String
  stock      InventoryStock    @relation(fields: [stockId], references: [id])
  orderId    String?
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime?
  createdAt  DateTime          @default(now())
  releasedAt DateTime?

  @@map("inventory_reservations")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  DEDUCTED
  EXPIRED
}

// ============================================================
// CART
// ============================================================

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])
  skuId     String
  sku       SKU      @relation(fields: [skuId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, skuId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id                      String        @id @default(uuid())
  orderNumber             String        @unique
  userId                  String
  user                    User          @relation(fields: [userId], references: [id])
  shopId                  String
  shop                    Shop          @relation(fields: [shopId], references: [id])
  status                  OrderStatus   @default(PENDING_PAYMENT)
  subtotal                Decimal       @db.Decimal(15, 2)
  discountAmount          Decimal       @default(0) @db.Decimal(15, 2)
  shippingFee             Decimal       @default(0) @db.Decimal(15, 2)
  shippingDiscount        Decimal       @default(0) @db.Decimal(15, 2)
  platformFee             Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount             Decimal       @db.Decimal(15, 2)
  paymentMethod           PaymentMethod @default(COD)
  paymentStatus           PaymentStatus @default(UNPAID)
  shippingAddressSnapshot Json
  noteFromBuyer           String?
  cancelReason            String?
  cancelledBy             String?
  cancelledAt             DateTime?
  completedAt             DateTime?
  source                  String        @default("buyer_web")
  referralCode            String?
  affiliateClickId        String?
  channel                 String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  items                OrderItem[]
  statusHistories      OrderStatusHistory[]
  payment              Payment?
  shipment             Shipment?
  promotionRedemptions PromotionRedemption[]
  returnRequests       ReturnRequest[]
  ledgerEntries        SellerLedgerEntry[]
  disputes             Dispute[]
  affiliateConversions AffiliateConversion[]

  @@map("orders")
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_SELLER_CONFIRM
  SELLER_CONFIRMED
  PACKED
  HANDED_TO_CARRIER
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  RETURNING
  RETURNED
  REFUNDING
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  VNPAY
  MOMO
  ZALOPAY
  CREDIT_CARD
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIAL_REFUNDED
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id])
  skuId               String
  sku                 SKU      @relation(fields: [skuId], references: [id])
  productNameSnapshot String
  skuNameSnapshot     String
  skuImageSnapshot    String?
  unitPrice           Decimal  @db.Decimal(15, 2)
  discountAmount      Decimal  @default(0) @db.Decimal(15, 2)
  finalPrice          Decimal  @db.Decimal(15, 2)
  quantity            Int
  subtotal            Decimal  @db.Decimal(15, 2)
  createdAt           DateTime @default(now())

  returnItems ReturnRequestItem[]

  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?
  actorType  String?
  createdAt  DateTime     @default(now())

  @@map("order_status_histories")
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id])
  method          PaymentMethod
  amount          Decimal       @db.Decimal(15, 2)
  status          PaymentStatus @default(UNPAID)
  transactionRef  String?
  gatewayResponse Json?
  paidAt          DateTime?
  failedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transactions PaymentTransaction[]

  @@map("payments")
}

model PaymentTransaction {
  id         String        @id @default(uuid())
  paymentId  String
  payment    Payment       @relation(fields: [paymentId], references: [id])
  type       String
  amount     Decimal       @db.Decimal(15, 2)
  status     PaymentStatus
  gatewayRef String?
  metadata   Json?
  createdAt  DateTime      @default(now())

  @@map("payment_transactions")
}

// ============================================================
// SHIPPING
// ============================================================

model ShippingMethod {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  feeRules ShippingFeeRule[]

  @@map("shipping_methods")
}

model ShippingFeeRule {
  id            String         @id @default(uuid())
  methodId      String
  method        ShippingMethod @relation(fields: [methodId], references: [id])
  fromProvince  String?
  toProvince    String?
  minWeight     Decimal?       @db.Decimal(10, 3)
  maxWeight     Decimal?       @db.Decimal(10, 3)
  baseFee       Decimal        @db.Decimal(15, 2)
  extraFeePerKg Decimal?       @db.Decimal(15, 2)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())

  @@map("shipping_fee_rules")
}

model ShippingCarrier {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  apiEndpoint String?
  apiKey      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  shipments      ShippingOrder[]
  orderShipments Shipment[]

  @@map("shipping_carriers")
}

model Shipment {
  id             String           @id @default(uuid())
  orderId        String           @unique
  order          Order            @relation(fields: [orderId], references: [id])
  carrierId      String?
  carrier        ShippingCarrier? @relation(fields: [carrierId], references: [id])
  trackingNumber String?
  status         ShipmentStatus   @default(PENDING)
  estimatedAt    DateTime?
  deliveredAt    DateTime?
  shippingFee    Decimal          @default(0) @db.Decimal(15, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  trackingLogs ShippingTrackingLog[]

  @@map("shipments")
}

model ShippingOrder {
  id              String          @id @default(uuid())
  carrierId       String
  carrier         ShippingCarrier @relation(fields: [carrierId], references: [id])
  orderId         String
  trackingNumber  String?
  status          ShipmentStatus  @default(PENDING)
  carrierResponse Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("shipping_orders")
}

model ShippingTrackingLog {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  status     String
  location   String?
  note       String?
  timestamp  DateTime
  createdAt  DateTime @default(now())

  @@map("shipping_tracking_logs")
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

// ============================================================
// PROMOTION
// ============================================================

model Promotion {
  id                String        @id @default(uuid())
  shopId            String?
  shop              Shop?         @relation("ShopPromotions", fields: [shopId], references: [id])
  type              PromotionType
  code              String?       @unique
  name              String
  description       String?
  discountType      DiscountType  @default(PERCENTAGE)
  discountValue     Decimal       @db.Decimal(15, 2)
  minOrderAmount    Decimal?      @db.Decimal(15, 2)
  maxDiscount       Decimal?      @db.Decimal(15, 2)
  usageLimit        Int?
  usageLimitPerUser Int?
  usedCount         Int           @default(0)
  startAt           DateTime
  endAt             DateTime
  isActive          Boolean       @default(true)
  createdBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  rules       PromotionRule[]
  targets     PromotionTarget[]
  redemptions PromotionRedemption[]

  @@map("promotions")
}

enum PromotionType {
  PLATFORM_VOUCHER
  SHOP_VOUCHER
  PRODUCT_DISCOUNT
  FLASH_SALE
  COMBO
  FREESHIP
  CAMPAIGN
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model PromotionRule {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  ruleType    String
  ruleValue   Json
  createdAt   DateTime  @default(now())

  @@map("promotion_rules")
}

model PromotionTarget {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  targetType  String
  targetId    String
  createdAt   DateTime  @default(now())

  @@map("promotion_targets")
}

model PromotionRedemption {
  id             String    @id @default(uuid())
  promotionId    String
  promotion      Promotion @relation(fields: [promotionId], references: [id])
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id])
  userId         String
  discountAmount Decimal   @db.Decimal(15, 2)
  createdAt      DateTime  @default(now())

  @@map("promotion_redemptions")
}

// ============================================================
// CAMPAIGN & FLASH SALE
// ============================================================

model Campaign {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  bannerUrl   String?
  type        CampaignType   @default(GENERAL)
  status      CampaignStatus @default(DRAFT)
  startAt     DateTime
  endAt       DateTime
  createdBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sellers        CampaignSeller[]
  products       CampaignProduct[]
  flashSaleSlots FlashSaleSlot[]

  @@map("campaigns")
}

enum CampaignType {
  GENERAL
  FLASH_SALE
  SEASONAL
  CATEGORY_FOCUS
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

model CampaignSeller {
  id         String         @id @default(uuid())
  campaignId String
  campaign   Campaign       @relation(fields: [campaignId], references: [id])
  shopId     String
  shop       Shop           @relation(fields: [shopId], references: [id])
  status     ApprovalStatus @default(PENDING)
  createdAt  DateTime       @default(now())

  @@map("campaign_sellers")
}

model CampaignProduct {
  id         String         @id @default(uuid())
  campaignId String
  campaign   Campaign       @relation(fields: [campaignId], references: [id])
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  status     ApprovalStatus @default(PENDING)
  createdAt  DateTime       @default(now())

  @@map("campaign_products")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model FlashSaleSlot {
  id         String    @id @default(uuid())
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  startAt    DateTime
  endAt      DateTime
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  items FlashSaleItem[]

  @@map("flash_sale_slots")
}

model FlashSaleItem {
  id         String         @id @default(uuid())
  slotId     String
  slot       FlashSaleSlot  @relation(fields: [slotId], references: [id])
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  skuId      String
  sku        SKU            @relation(fields: [skuId], references: [id])
  flashPrice Decimal        @db.Decimal(15, 2)
  quota      Int
  soldCount  Int            @default(0)
  status     ApprovalStatus @default(PENDING)
  createdAt  DateTime       @default(now())

  @@map("flash_sale_items")
}

model ComboDeal {
  id            String       @id @default(uuid())
  shopId        String
  name          String
