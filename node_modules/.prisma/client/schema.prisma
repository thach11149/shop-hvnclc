// ============================================================
// WAREHOUSE & FULFILLMENT (Phase 3)
// ============================================================

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  province  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks            WarehouseStock[]
  inboundRequests   WarehouseInboundRequest[]
  outboundRequests  WarehouseOutboundRequest[]
  fulfillmentOrders FulfillmentOrder[]

  @@map("warehouses")
}

model WarehouseStock {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  skuId       String
  quantity    Int       @default(0)
  reservedQty Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  movements WarehouseStockMovement[]

  @@unique([warehouseId, skuId])
  @@map("warehouse_stocks")
}

model WarehouseStockMovement {
  id        String         @id @default(uuid())
  stockId   String
  stock     WarehouseStock @relation(fields: [stockId], references: [id])
  type      MovementType
  quantity  Int
  reference String?
  note      String?
  createdAt DateTime       @default(now())

  @@map("warehouse_stock_movements")
}

enum MovementType {
  INBOUND
  OUTBOUND
  TRANSFER
  ADJUSTMENT
  RETURN
}

model WarehouseInboundRequest {
  id          String        @id @default(uuid())
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  shopId      String
  shop        Shop          @relation(fields: [shopId], references: [id])
  status      InboundStatus @default(PENDING)
  scheduledAt DateTime?
  receivedAt  DateTime?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("warehouse_inbound_requests")
}

enum InboundStatus {
  PENDING
  SCHEDULED
  RECEIVED
  VERIFIED
  CANCELLED
}

model WarehouseOutboundRequest {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  orderId     String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())

  @@map("warehouse_outbound_requests")
}

model FulfillmentOrder {
  id          String            @id @default(uuid())
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  orderId     String
  status      FulfillmentStatus @default(PENDING)
  pickedAt    DateTime?
  packedAt    DateTime?
  handedAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  items FulfillmentOrderItem[]

  @@map("fulfillment_orders")
}

model FulfillmentOrderItem {
  id             String           @id @default(uuid())
  fulfillmentId  String
  fulfillment    FulfillmentOrder @relation(fields: [fulfillmentId], references: [id])
  skuId          String
  quantity       Int
  pickedQuantity Int              @default(0)
  createdAt      DateTime         @default(now())

  @@map("fulfillment_order_items")
}

enum FulfillmentStatus {
  PENDING
  PICKING
  PICKED
  PACKING
  PACKED
  HANDED_OVER
  CANCELLED
}

// ============================================================
// ADS (Phase 3)
// ============================================================

model AdsCampaign {
  id          String            @id @default(uuid())
  shopId      String
  shop        Shop              @relation(fields: [shopId], references: [id])
  name        String
  type        AdsType           @default(SPONSORED_PRODUCT)
  status      AdsCampaignStatus @default(DRAFT)
  budget      Decimal           @db.Decimal(15, 2)
  dailyBudget Decimal?          @db.Decimal(15, 2)
  spentAmount Decimal           @default(0) @db.Decimal(15, 2)
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  adGroups  AdsAdGroup[]
  spendLogs AdsSpendLog[]

  @@map("ads_campaigns")
}

enum AdsType {
  SPONSORED_PRODUCT
  BANNER
  KEYWORD
}

enum AdsCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  REJECTED
}

model AdsAdGroup {
  id         String      @id @default(uuid())
  campaignId String
  campaign   AdsCampaign @relation(fields: [campaignId], references: [id])
  name       String
  productId  String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())

  keywords    AdsKeyword[]
  impressions AdsImpression[]
  clicks      AdsClick[]
  conversions AdsConversion[]

  @@map("ads_ad_groups")
}

model AdsKeyword {
  id        String     @id @default(uuid())
  groupId   String
  group     AdsAdGroup @relation(fields: [groupId], references: [id])
  keyword   String
  bidAmount Decimal    @db.Decimal(15, 2)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@map("ads_keywords")
}

model AdsImpression {
  id        String     @id @default(uuid())
  groupId   String
  group     AdsAdGroup @relation(fields: [groupId], references: [id])
  userId    String?
  position  Int?
  page      String?
  createdAt DateTime   @default(now())

  @@map("ads_impressions")
}

model AdsClick {
  id        String     @id @default(uuid())
  groupId   String
  group     AdsAdGroup @relation(fields: [groupId], references: [id])
  userId    String?
  ipAddress String?
  cost      Decimal    @default(0) @db.Decimal(15, 2)
  createdAt DateTime   @default(now())

  @@map("ads_clicks")
}

model AdsConversion {
  id        String     @id @default(uuid())
  groupId   String
  group     AdsAdGroup @relation(fields: [groupId], references: [id])
  orderId   String?
  revenue   Decimal    @db.Decimal(15, 2)
  createdAt DateTime   @default(now())

  @@map("ads_conversions")
}

model AdsSpendLog {
  id          String      @id @default(uuid())
  campaignId  String
  campaign    AdsCampaign @relation(fields: [campaignId], references: [id])
  date        DateTime    @db.Date
  spend       Decimal     @db.Decimal(15, 2)
  impressions Int         @default(0)
  clicks      Int         @default(0)
  conversions Int         @default(0)
  revenue     Decimal     @default(0) @db.Decimal(15, 2)
  createdAt   DateTime    @default(now())

  @@map("ads_spend_logs")
}

