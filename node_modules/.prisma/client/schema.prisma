  invite    ReferralInvite @relation(fields: [inviteId], references: [id])
  userId    String
  type      String
  value     Decimal        @db.Decimal(15, 2)
  createdAt DateTime       @default(now())

  @@map("referral_rewards")
}

// ============================================================
// DISPUTE (Phase 3)
// ============================================================

model Dispute {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  shopId      String
  shop        Shop          @relation(fields: [shopId], references: [id])
  openedBy    String
  reason      String
  description String?
  status      DisputeStatus @default(OPEN)
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  messages  DisputeMessage[]
  evidences DisputeEvidence[]
  decisions DisputeDecision[]

  @@map("disputes")
}

enum DisputeStatus {
  OPEN
  SELLER_RESPONDED
  ADMIN_REVIEWING
  RESOLVED
  CLOSED
}

model DisputeMessage {
  id         String   @id @default(uuid())
  disputeId  String
  dispute    Dispute  @relation(fields: [disputeId], references: [id])
  senderId   String
  senderType String
  content    String
  createdAt  DateTime @default(now())

  @@map("dispute_messages")
}

model DisputeEvidence {
  id         String   @id @default(uuid())
  disputeId  String
  dispute    Dispute  @relation(fields: [disputeId], references: [id])
  uploaderId String
  type       String
  url        String
  createdAt  DateTime @default(now())

  @@map("dispute_evidences")
}

model DisputeDecision {
  id        String   @id @default(uuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id])
  deciderId String
  decision  String
  note      String?
  createdAt DateTime @default(now())

  @@map("dispute_decisions")
}

// ============================================================
// FRAUD & RISK (Phase 3)
// ============================================================

model FraudRule {
  id         String   @id @default(uuid())
  name       String
  ruleType   String
  conditions Json
  action     String
  threshold  Decimal? @db.Decimal(10, 4)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("fraud_rules")
}

model FraudCase {
  id          String    @id @default(uuid())
  entityType  String
  entityId    String
  ruleId      String?
  severity    String
  status      String    @default("open")
  description String?
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("fraud_cases")
}

model RiskEvent {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  eventType  String
  riskValue  Decimal? @db.Decimal(10, 4)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("risk_events")
}

model RiskScore {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  score      Decimal  @db.Decimal(10, 4)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  histories RiskScoreHistory[]

  @@unique([entityType, entityId])
  @@map("risk_scores")
}

model RiskScoreHistory {
  id          String    @id @default(uuid())
  riskScoreId String
  riskScore   RiskScore @relation(fields: [riskScoreId], references: [id])
  score       Decimal   @db.Decimal(10, 4)
  reason      String?
  createdAt   DateTime  @default(now())

  @@map("risk_score_histories")
}

// ============================================================
// POLICY ENGINE (Phase 3)
// ============================================================

model PolicyRule {
  id         String   @id @default(uuid())
  name       String
  ruleType   String
  conditions Json
  actions    Json
  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  versions      PolicyRuleVersion[]
  targets       PolicyTarget[]
  executionLogs PolicyExecutionLog[]

  @@map("policy_rules")
}

model PolicyRuleVersion {
  id         String     @id @default(uuid())
  ruleId     String
  rule       PolicyRule @relation(fields: [ruleId], references: [id])
  version    Int
  conditions Json
  actions    Json
  createdAt  DateTime   @default(now())

  @@map("policy_rule_versions")
}

model PolicyTarget {
  id         String     @id @default(uuid())
  ruleId     String
  rule       PolicyRule @relation(fields: [ruleId], references: [id])
  targetType String
  targetId   String?
  createdAt  DateTime   @default(now())

  @@map("policy_targets")
}

model PolicyExecutionLog {
  id         String     @id @default(uuid())
  ruleId     String
  rule       PolicyRule @relation(fields: [ruleId], references: [id])
  entityType String
  entityId   String
  result     Json?
  createdAt  DateTime   @default(now())

  @@map("policy_execution_logs")
}

// ============================================================
// MARKETING AUTOMATION (Phase 4)
// ============================================================

model CustomerSegment {
  id          String   @id @default(uuid())
  name        String
  description String?
  conditions  Json
  isActive    Boolean  @default(true)
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members         CustomerSegmentMember[]
  automationFlows MarketingAutomationFlow[]

  @@map("customer_segments")
}

model CustomerSegmentMember {
  id        String          @id @default(uuid())
  segmentId String
  segment   CustomerSegment @relation(fields: [segmentId], references: [id])
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  createdAt DateTime        @default(now())

  @@unique([segmentId, userId])
  @@map("customer_segment_members")
}

model MarketingAutomationFlow {
  id        String           @id @default(uuid())
  segmentId String?
  segment   CustomerSegment? @relation(fields: [segmentId], references: [id])
  name      String
  trigger   String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  steps MarketingAutomationStep[]

  @@map("marketing_automation_flows")
}

model MarketingAutomationStep {
  id        String                  @id @default(uuid())
  flowId    String
  flow      MarketingAutomationFlow @relation(fields: [flowId], references: [id])
  stepType  String
  config    Json
  delayMins Int                     @default(0)
  position  Int                     @default(0)
  createdAt DateTime                @default(now())

  @@map("marketing_automation_steps")
}

model MarketingMessage {
  id        String   @id @default(uuid())
  type      String
  subject   String?
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  logs MarketingMessageLog[]

  @@map("marketing_messages")
}

model MarketingMessageLog {
  id        String           @id @default(uuid())
  messageId String
  message   MarketingMessage @relation(fields: [messageId], references: [id])
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  status    String
  sentAt    DateTime?
  openedAt  DateTime?
  createdAt DateTime         @default(now())

  @@map("marketing_message_logs")
}

// ============================================================
// BANNERS
// ============================================================

model Banner {
  id        String    @id @default(uuid())
  title     String?
  imageUrl  String
  link      String?
  position  String    @default("home_top")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("banners")
}
