DATABASE_URL="postgresql://postgres:password@localhost:5432/marketplace_db"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development

# Redis (optional — caching disabled gracefully if not set)
REDIS_URL="redis://localhost:6379"

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="HVNCLC Shop <no-reply@hvnclc.vn>"
# Development: use Ethereal https://ethereal.email
ETHEREAL_USER=
ETHEREAL_PASS=

# Frontend URLs
FRONTEND_URL=http://localhost:3000
BUYER_WEB_URL=http://localhost:5173

# VNPay payment gateway (sandbox)
VNPAY_TMN_CODE=YOUR_TMN_CODE
VNPAY_HASH_SECRET=YOUR_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/result

# MoMo payment gateway (sandbox)
MOMO_PARTNER_CODE=MOMO_PARTNER_CODE
MOMO_ACCESS_KEY=YOUR_ACCESS_KEY
MOMO_SECRET_KEY=YOUR_SECRET_KEY
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:5173/payment/result
MOMO_NOTIFY_URL=http://localhost:3001/api/v1/payments/momo/callback

# ZaloPay payment gateway (sandbox)
ZALO_APP_ID=YOUR_APP_ID
ZALO_KEY1=YOUR_KEY1
ZALO_KEY2=YOUR_KEY2
ZALO_API_URL=https://sb-openapi.zalopay.vn/v2/create
ZALO_CALLBACK_URL=http://localhost:3001/api/v1/payments/zalopay/callback

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-6

# Bank transfer info
BANK_ACCOUNT_NUMBER=1234567890
BANK_NAME=Vietcombank

# Payout scheduler
ENABLE_PAYOUT_SCHEDULER=true
PAYOUT_INTERVAL_HOURS=24

UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
